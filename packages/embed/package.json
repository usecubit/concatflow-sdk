{
  "name": "@concatflow/embed",
  "version": "0.2.0",
  "description": "Browser loader for the Concatflow embedded assistant, with a React component.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usecubit/concatflow-sdk.git",
    "directory": "packages/embed"
  },
  "keywords": [
    "concatflow",
    "embedded-assistant",
    "widget",
    "react"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "scripts": {
    "prepack": "tsc -p tsconfig.build.json"
  },
  "publishConfig": {
    "access": "public"
  }
}
